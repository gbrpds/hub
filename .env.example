DATABASE_URL="postgresql://user:password@localhost:5432/hub?schema=public"

# Auth.js — gerar com: npx auth secret (ou `openssl rand -base64 32`)
AUTH_SECRET=""

# SMTP usado para enviar o magic link do CLIENT
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Hub <no-reply@example.com>"

# Usados apenas pelo script de seed (prisma/seed.ts) para criar o primeiro ADMIN
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ATENÇÃO: com "true", qualquer e-mail/senha loga como ADMIN, sem checar
# o banco. Só pra destravar o desenvolvimento. Remova antes de ir pra
# produção de verdade / antes de ter clientes reais usando o site.
AUTH_DEV_BYPASS=""
