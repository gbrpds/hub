# ===========================================================================
# Banco de dados (obrigatório)
# ===========================================================================
# String de conexão do Postgres. Na Vercel, ao criar um Postgres em Storage,
# essa variável é preenchida automaticamente.
DATABASE_URL="postgresql://user:password@localhost:5432/hub?schema=public"

# ===========================================================================
# Autenticação — Auth.js (obrigatório em produção)
# ===========================================================================
# Segredo que assina as sessões. Gere em https://generate-secret.vercel.app/32
# (ou `npx auth secret`). SEM isso o login mostra "Server error".
AUTH_SECRET=""

# Liga a exigência de login. Enquanto vazio/ausente, /admin e /portal ficam
# abertos (modo prévia/desenvolvimento). Defina "true" quando o login estiver
# funcionando para proteger as áreas de verdade.
AUTH_GATE_ENABLED=""

# Só em hospedagem fora da Vercel: defina "true" se o Auth.js reclamar de host
# não confiável. Na Vercel não precisa.
# AUTH_TRUST_HOST=""

# ===========================================================================
# E-mail (obrigatório para o magic link do CLIENT funcionar)
# ===========================================================================
# SMTP usado para enviar o link de acesso do cliente ao portal.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Hub <no-reply@example.com>"

# ===========================================================================
# Criação do primeiro ADMIN
# ===========================================================================
# Lidos pelo seed (npm run db:seed) e pela rota /api/admin/bootstrap.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Chave que protege a rota GET /api/admin/bootstrap (criar o admin sem
# terminal). Defina um valor secreto qualquer, acesse
# /api/admin/bootstrap?secret=SEU_VALOR uma vez, e depois REMOVA esta
# variável para desativar a rota.
ADMIN_BOOTSTRAP_SECRET=""

# ===========================================================================
# Atalho de desenvolvimento (NÃO usar em produção)
# ===========================================================================
# Com "true", o login de ADMIN aceita qualquer e-mail/senha sem checar o
# banco. Só para destravar o desenvolvimento. Deixe vazio em produção.
AUTH_DEV_BYPASS=""
