// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT)

  // Usado apenas pelo login de ADMIN (e-mail e senha).
  passwordHash String?

  // Vincula um usuário CLIENT ao registro de cliente correspondente.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  accounts Account[]
  sessions Session[]

  assignedDemands Demand[]   @relation("DemandAssignee")
  comments        Comment[]
  tasks           Task[]
  activities      Activity[]
  agentConfig     AgentConfig?
  contentChats    ContentChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ClientStatus {
  ATIVO
  INATIVO
}

model Client {
  id       String       @id @default(cuid())
  name     String
  photoUrl String?
  status   ClientStatus @default(ATIVO)

  // Serviços prestados (ex: "Edição de vídeo", "Social media", "Design").
  services String[] @default([])

  // Texto livre para dar contexto sobre o cliente a ferramentas de IA.
  context String? @db.Text

  contactPhone   String?
  contactEmail   String?
  contactWebsite String?

  // Um cliente pode ter mais de um @ do Instagram.
  instagrams String[] @default([])

  contractStartDate DateTime?

  // Contrato: PDF anexado (contractUrl) ou marcado como sem contrato.
  contractUrl String?
  noContract  Boolean @default(false)

  driveUrl String?

  users          User[]
  demands        Demand[]
  financeEntries FinanceEntry[]
  payments       Payment[]
  contentChats   ContentChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Um pagamento recorrente do cliente (valor + dia do mês). Um cliente pode
// ter vários (ex: entrada + parcelas). O Financeiro soma todos como valor mensal.
model Payment {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label    String?
  value    Decimal @db.Decimal(10, 2)
  dueDay   Int?
  order    Int     @default(0)

  financeEntries FinanceEntry[]

  createdAt DateTime @default(now())

  @@index([clientId])
}

enum Priority {
  URGENTE
  ALTA
  MEDIA
  BAIXA
}

enum DemandStatus {
  RECEBIDA
  EM_PRODUCAO
  APROVACAO
  PROGRAMAR
  CONCLUIDO
  REPROVADO
  INTERNO
}

enum ContentType {
  POST
  CARROSSEL
  REELS
  STORY
  VIDEO_LONGO
}

model Demand {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  caption     String?      @db.Text
  status      DemandStatus @default(RECEBIDA)
  priority    Priority     @default(MEDIA)
  contentType ContentType?

  // Opcional: demandas INTERNO não têm cliente.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("DemandAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate     DateTime?
  publishDate DateTime?

  subtasks    Subtask[]
  comments    Comment[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([updatedAt])
}

model Subtask {
  id    String  @id @default(cuid())
  title String
  done  Boolean @default(false)

  demandId String
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demandId])
}

model Comment {
  id   String @id @default(cuid())
  text String @db.Text

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  demandId String
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([demandId])
}

enum AttachmentType {
  CLIENTE
  ENTREGA
}

// Anexos do cliente (material enviado) e arquivos de entrega (material
// finalizado) usam o mesmo model, diferenciados pelo campo `type`.
model Attachment {
  id       String         @id @default(cuid())
  url      String
  fileName String?
  type     AttachmentType

  demandId String
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([demandId])
  @@index([type])
}

// To-do list pessoal do usuário, sem relação com cliente ou demanda.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  done        Boolean   @default(false)
  dueDate     DateTime?
  priority    Priority  @default(MEDIA)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Subtarefas: auto-relação (uma tarefa pode ter subtarefas).
  parentId String?
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskSubtasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([parentId])
}

enum FinanceStatus {
  PAGO
  PENDENTE
}

model FinanceEntry {
  id    String  @id @default(cuid())
  value Decimal @db.Decimal(10, 2)

  // Primeiro dia do mês de referência (ex: 2026-07-01 para julho/2026).
  referenceMonth DateTime
  status         FinanceStatus @default(PENDENTE)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Cada lançamento corresponde a um pagamento do cliente (quando aplicável).
  // label guarda o nome/dia do pagamento mesmo que ele seja removido depois.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  label     String?
  dueDay    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([paymentId])
}

// Feed de atividade recente do dashboard.
model Activity {
  id          String   @id @default(cuid())
  description String   @db.Text
  type        String
  createdAt   DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// Configuração global do agente de conteúdo ("cérebro da marca"):
// a metodologia de criação escrita uma vez e aplicada a todos os clientes.
// Uma linha por ADMIN dono.
model AgentConfig {
  id           String @id @default(cuid())
  ownerId      String @unique
  owner        User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  instructions String @db.Text @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChatRole {
  USER
  ASSISTANT
}

// Uma conversa com o agente de conteúdo, normalmente ancorada num cliente
// (o agente puxa o context/serviços/demandas dele como base de conhecimento).
model ContentChat {
  id      String  @id @default(cuid())
  title   String  @default("Nova conversa")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  messages ContentMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([clientId])
  @@index([updatedAt])
}

model ContentMessage {
  id      String   @id @default(cuid())
  role    ChatRole
  content String   @db.Text

  chatId String
  chat   ContentChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([chatId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Necessário para o login por magic link (CLIENT).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
